        "mode": "runOnceForEachItem",
        "jsCode": "\nconst row = item.json;\n\nconst cleanRow = {\n  fullName: row[\"Full Name\"]?.toString().trim().replace(/\\s+/g, \" \") || \"\",\n\n  email: row[\"Email\"]?.toString().trim().toLowerCase() || \"\",\n\n  amount: row[\"Amount\"] ? Number(row[\"Amount\"]) : 0,\n\n  date: row[\"Date\"] ? new Date(row[\"Date\"]).toISOString().split(\"T\")[0] : \"\",\n\n  message: row[\"Message\"]\n    ? row[\"Message\"].toString().trim().replace(/\\s+/g, \" \")\n    : \"\",\n\n  // ✅ NEW: Clean Message\n  cleanMessage: row[\"Message\"]\n    ? row[\"Message\"]\n        .toString()\n        .trim()\n        .replace(/\\s+/g, \" \")\n        .replace(/[^a-zA-Z0-9 .,!?@]/g, \"\")   // optional: remove weird symbols\n    : \"\",\n\n  // ✅ NEW: Subject field\n  subject: row[\"Subject\"]\n    ? row[\"Subject\"].toString().trim().replace(/\\s+/g, \" \")\n    : \"New message recive\"\n};\n\nreturn {\n  json: cleanRow\n};"
      },
